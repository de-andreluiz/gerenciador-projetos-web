{
  "name": "gerenciador-projetos",
  "version": "1.0.0",
  "description": "Gerenciador de projetos de migração: diretórios, bases SQL Server, planilhas DE-PARA e cronograma simples.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:web": "GP_STORAGE_BACKEND=sqlite node server.js",
    "migrate:sqlite": "node scripts/migrate-to-sqlite.js",
    "build:desktop": "node scripts/build-desktop.js",
    "test": "node --test \"test/*.test.js\" \"supabase/tests/*.test.js\"",
    "scan:secrets": "node scripts/scan-secrets.js",
    "test:rls": "node --test \"supabase/tests/*.test.js\"",
    "test:supabase": "node --test --test-force-exit --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^183.0.0",
    "msnodesqlv8": "^5.5.0",
    "mssql": "^12.7.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
