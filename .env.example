# Copie para .env e preencha. O .env NUNCA é commitado (está no .gitignore).
# Este arquivo só lista NOMES de variáveis; nenhum valor real aqui.

# --- Supabase (Project Settings → API Keys) ---
# URL do projeto e a PUBLISHABLE key (sb_publishable_...). Ela é feita para clientes; a segurança vem do Auth + RLS.
# Mesmo assim fica fora do Git para não expor o endpoint do projeto.
GP_SUPABASE_URL=https://<project-ref>.supabase.co
GP_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# dev | prod — qual projeto Supabase este build usa
GP_ENV=dev
# local (padrão: data\projects.json, sem login) | cloud (login obrigatório; dados no Supabase).
# Mantenha "local" no uso diário até a migração (Fase 6); use "cloud" só para testar o login no gp-dev.
GP_MODE=local

# --- Atualizações ---
GP_UPDATE_CHANNEL=stable

# --- Backend de armazenamento (novo) ---
# sqlite (padrão, local) | local (JSON legado) | cloud (Supabase)
GP_STORAGE_BACKEND=sqlite

# --- Criptografia de senhas (src/crypto-secrets.js — substituto cross-platform do DPAPI) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBRIGATÓRIO em produção; em dev, usa fallback derivado de hostname (INSEGURO).
GP_SECRET_KEY=<hex-64-chars>

# --- Google Drive API (src/drive.js) ---
# Opção 1: Service Account (tem prioridade se definida)
# GP_DRIVE_KEYFILE=/caminho/para/service-account.json
# Opção 2: OAuth2 (credentials + token salvo pelo flow de autorização)
# GP_DRIVE_CREDENTIALS=/caminho/para/credentials.json
# GP_DRIVE_TOKEN=/caminho/para/token.json
# Escopo (padrão: drive completo; use drive.file para acesso restrito)
# GP_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# --- Desenvolvimento / testes (opcionais) ---
# Pasta de dados alternativa (testes usam pasta temporária; nunca apontar para dados reais em teste)
# GP_DATA_DIR=
# Raiz dos dados locais (padrão: %LOCALAPPDATA%\GerenciadorProjetos)
# GP_LOCAL_DIR=
PORT=4317

# ---------------------------------------------------------------------
# NUNCA coloque neste arquivo nem em nenhum arquivo do projeto:
#   - SUPABASE_SERVICE_ROLE_KEY / secret keys (sb_secret_...)
#   - GP_KEK_V1 (chave-mestra de criptografia)
#   - chave privada de assinatura de releases
#   - senhas de banco, tokens, refresh tokens
# Esses valores ficam só nos Secrets das Edge Functions (painel do Supabase)
# ou guardados offline pelo MASTER. Ver docs/SECURITY.md.
# ---------------------------------------------------------------------
